# Configuração do Servidor Neo-Tokyo
PORT=3001
NODE_ENV=development

# Credenciais do Mercado Pago (Developers Dashboard)
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MERCADO_PAGO_WEBHOOK_SECRET=

# URL Base pública para webhooks (ex: https://seu-dominio.ngrok-free.app)
WEBHOOK_BASE_URL=

# Se verdadeiro ou sem token válido, permite simulação instantânea de pagamento para testes
ALLOW_DEV_SIMULATION=true
